# ── Base ────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# ── MongoDB ─────────────────────────────────────────────────────────────
MONGO_URI=mongodb://localhost:27017/agroguard

# ── JWT / Auth ──────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=development_super_secret_jwt_access_key_min_32_chars!
JWT_ACCESS_TTL=15m
REFRESH_TTL_DAYS=30

# ── CORS ────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Inferencia ──────────────────────────────────────────────────────────
INFERENCE_DRIVER=ensemble
INFERENCE_TIMEOUT_MS=15000

# ── Microservicios FastAPI ──────────────────────────────────────────────
CLIP_SERVICE_URL=http://localhost:8001
ENSEMBLE_SERVICE_URL=http://localhost:8002

# ── Filtro CLIP ─────────────────────────────────────────────────────────
# Los umbrales se aplican sobre la MASA de probabilidad de cada grupo
# (planta / no válido / cultivo no soportado), no sobre una etiqueta aislada.
CLIP_ENABLED=true
CLIP_THRESHOLD_PLANT=0.30
CLIP_THRESHOLD_NO_PLANT=0.70
CLIP_THRESHOLD_UNSUPPORTED_CROP=0.60

# ── Modelos ─────────────────────────────────────────────────────────────
MODEL_ROOT=agroguard_modelos_completos
EXPECTED_NUM_CLASSES=38
MIN_CONFIDENCE=0.60

# ── Almacenamiento ─────────────────────────────────────────────────────
STORAGE_DIR=uploads/images
MAX_UPLOAD_MB=8